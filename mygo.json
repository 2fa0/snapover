{
  "name": "Snapover",
  "identifier": "app.snapover.desktop",
  "version": "0.1.0",
  "main": "./cmd/snapover",
  "icon": "resources/icon.png",
  "out": "dist",
  "macos": {
    "minimumSystemVersion": "12.0",
    "dmgTitle": "Snapover",
