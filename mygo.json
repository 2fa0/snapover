{
  "name": "Snapover",
  "slug": "snapover",
  "identifier": "app.snapover.desktop",
  "version": "0.10.5",
  "license": "MIT",
  "copyright": "© 2026 2fa0",
  "main": "./cmd/snapover",
  "icon": "resources/app.png",
  "out": "dist",
  "resources": ["LICENSE"],
  "updates": {
    "publicKey": "OOzAOkBfq4xG7K3e216vyE3WHcMAoDrIAyxJq/X4PPg=",
    "github": "2fa0/snapover-release",
    "changelog": "docs/CHANGELOG.md",
    "privateKey": "~/.config/snapover/update-keys/mygo-update.key"
  },
  "macos": {
    "minimumSystemVersion": "13.0",
    "dmgTitle": "Snapover",
    "infoPlist": {
      "LSApplicationCategoryType": "public.app-category.utilities",
      "NSLocalNetworkUsageDescription": "Snapover 需要发现并连接同一局域网内的电脑，用于配对、同步剪贴板和发送文件。",
      "NSBonjourServices": ["_snapover._tcp"],
      "NSServices": [{
        "NSMenuItem": {"default": "Snapover 发送文件"},
        "NSMessage": "sendFiles",
        "NSPortName": "Snapover",
        "NSRequiredContext": {"NSApplicationIdentifier": "com.apple.finder"},
        "NSSendFileTypes": ["public.item"]
      }]
    }
  }
}
